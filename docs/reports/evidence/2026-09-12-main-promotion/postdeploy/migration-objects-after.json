  "constraints": [
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_backtest_job_id_fkey",
      "definition": "FOREIGN KEY (backtest_job_id) REFERENCES backtest_jobs(id) ON DELETE SET NULL"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_backtest_run_id_fkey",
      "definition": "FOREIGN KEY (backtest_run_id) REFERENCES backtest_runs(id) ON DELETE SET NULL"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_billable_quantity_check",
      "definition": "CHECK (((billable_quantity IS NULL) OR (billable_quantity >= (0)::numeric)))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_billable_unit_check",
      "definition": "CHECK ((billable_unit = ANY (ARRAY['token'::text, 'request'::text, 'compute_second'::text, 'audio_second'::text, 'storage_byte'::text, 'row'::text, 'unknown'::text])))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_conversation_id_fkey",
      "definition": "FOREIGN KEY (conversation_id) REFERENCES conversations(id) ON DELETE SET NULL"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_cost_amount_check",
      "definition": "CHECK (((cost_amount IS NULL) OR (cost_amount >= (0)::numeric)))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_cost_source_check",
      "definition": "CHECK ((cost_source = ANY (ARRAY['provider_reported'::text, 'estimated'::text, 'derived'::text, 'reconciled'::text, 'unavailable'::text])))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_input_tokens_check",
      "definition": "CHECK (((input_tokens IS NULL) OR (input_tokens >= 0)))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_latency_ms_check",
      "definition": "CHECK (((latency_ms IS NULL) OR (latency_ms >= 0)))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_message_id_fkey",
      "definition": "FOREIGN KEY (message_id) REFERENCES messages(id) ON DELETE SET NULL"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_output_tokens_check",
      "definition": "CHECK (((output_tokens IS NULL) OR (output_tokens >= 0)))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_route_receipt_id_fkey",
      "definition": "FOREIGN KEY (route_receipt_id) REFERENCES route_receipts(id) ON DELETE SET NULL"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_source_check",
      "definition": "CHECK ((source = ANY (ARRAY['api_turn'::text, 'render_workflow'::text, 'eval_harness'::text, 'manual_reconciliation'::text, 'runtime_compute'::text, 'storage'::text, 'market_data'::text, 'stt'::text, 'research'::text])))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['succeeded'::text, 'failed'::text, 'skipped'::text, 'estimated'::text, 'reconciled'::text])))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_status_required",
      "definition": "CHECK (((status IS NOT NULL) OR ((source = 'research'::text) AND (feature_area = 'research_rail'::text))))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_total_tokens_check",
      "definition": "CHECK (((total_tokens IS NULL) OR (total_tokens >= 0)))"
    },
    {
      "table_name": "cost_ledger_entries",
      "name": "cost_ledger_entries_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE SET NULL"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_attachment_check",
      "definition": "CHECK (((evidence_artifact_id IS NOT NULL) <> (computation IS NOT NULL)))"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_decision_state_check",
      "definition": "CHECK ((decision_state = ANY (ARRAY['watching'::text, 'promising'::text, 'rejected'::text, 'revisit_later'::text])))"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_evidence_artifact_id_fkey",
      "definition": "FOREIGN KEY (evidence_artifact_id) REFERENCES evidence_artifacts(id) ON DELETE CASCADE"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_evidence_lineage_check",
      "definition": "CHECK ((((evidence_artifact_id IS NULL) = (idea_id IS NULL)) AND ((evidence_artifact_id IS NULL) = (idea_version_id IS NULL))))"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_idea_id_fkey",
      "definition": "FOREIGN KEY (idea_id) REFERENCES ideas(id) ON DELETE CASCADE"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_idea_version_id_fkey",
      "definition": "FOREIGN KEY (idea_version_id) REFERENCES idea_versions(id) ON DELETE CASCADE"
    },
    {
      "table_name": "decision_notes",
      "name": "decision_notes_pkey",
      "definition": "PRIMARY KEY (id)"

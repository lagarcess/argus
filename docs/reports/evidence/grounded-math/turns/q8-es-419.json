  "asked_at": "2026-09-13T06:34:49.452859+00:00",
  "turns": [
    {
      "message": "¿Mi cuenta de ahorros de verdad está perdiendo dinero?",
      "action": null,
      "message_id": "84590de2-b3a5-4039-8097-4deaeeaff3ee",
      "first_answer_seconds": 94.38,
      "final_answer_seconds": 94.38,
      "research_job_id": null,
      "elapsed_seconds": 94.38,
      "timeline": [
        {
          "at": 0.01,
          "type": "stage_start",
          "stage": "interpret"
        },
        {
          "at": 11.62,
          "type": "stage_start",
          "stage": "research_search",
          "detail": "balanced"
        },
        {
          "at": 94.35,
          "type": "stage_outcome",
          "outcome": "ready_to_respond"

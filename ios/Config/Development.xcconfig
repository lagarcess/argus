// Simulator-only placeholder. Production identity and signing remain unapproved.
ARGUS_LOCAL_BUNDLE_IDENTIFIER = local.argus.foundation
// Design preview stays off; only a local standalone preview build sets this to true.
CUADRAO_DESIGN_PREVIEW = false
// Local ad-hoc simulator signature supplies Keychain identity; no account/team.
CODE_SIGNING_ALLOWED = YES
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = Config/Simulator.entitlements
CODE_SIGNING_REQUIRED = NO
DEVELOPMENT_TEAM =
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
SWIFT_VERSION = 5.0
ONLY_ACTIVE_ARCH = YES
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// Session continuation is opt-in. Public configuration only; no passwords or service keys.
ARGUS_AUTH_ENABLED = false
ARGUS_API_URL =
ARGUS_SUPABASE_URL =
ARGUS_SUPABASE_ANON_KEY =
ARGUS_WEB_URL =
ARGUS_CAPTCHA_URL =
// Native Apple and Google sign-in. Both default off; see ../AUTH_SETUP.md. Public ids only.
ARGUS_APPLE_SIGN_IN_ENABLED = false
ARGUS_GOOGLE_SIGN_IN_ENABLED = false
// <number>-<id>.apps.googleusercontent.com (iOS client) and the web client used by Supabase.
ARGUS_GOOGLE_IOS_CLIENT_ID =
ARGUS_GOOGLE_WEB_CLIENT_ID =
// The iOS client's reversed id (com.googleusercontent.apps.<number>-<id>). The inert default
// keeps the URL type valid; the Google button stays hidden until it matches the client id.
ARGUS_GOOGLE_IOS_URL_SCHEME = argus-google-sign-in-unconfigured
// Optional ignored overrides for local development; never put secrets here.
#include? "Local.xcconfig"
// Opt-in device overrides belong to the approved local signing setup.
#include? "Device.local.xcconfig"

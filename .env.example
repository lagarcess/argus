# Argus Configuration Example
# Copy this file to .env and fill in your actual values
# Guest Experience rollout controls.
ARGUS_GUEST_ACCESS_ENABLED=true
ARGUS_PUBLIC_ACCOUNT_ACCESS_ENABLED=false
ARGUS_VISITOR_KEY_SECRET=replace_with_a_unique_random_secret
NEXT_PUBLIC_GUEST_ACCESS_ENABLED=true
#
# TWO MAIN LOCAL SCENARIOS:
#   1. DEV MODE: Fast iteration, no persistence, memory-only, synthetic data
#      - Run: .github/dev.sh
#      - API keys can be dummy values unless you test LLM/provider behavior.
#   2. QA MODE: Production-parity manual browser QA
#      - Run: .github/qa.sh
#      - Requires REAL Supabase, OpenRouter, Alpaca, and Postgres pooler values.
#
# The mode scripts are authoritative for runtime mode flags. Keep this file as a
# secrets/defaults template; do not manually juggle mode combinations for normal
# local work.

# =============================================================================
# REQUIRED: Alpaca API Credentials (Market Data)
# DEV MODE: Dummy values OK (e.g., "dummy_dev_key")
# QA MODE: Real Alpaca keys required for asset resolution
# =============================================================================
# Get your API keys from: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Use paper trading endpoints (set to false for live data)
ALPACA_PAPER_TRADING=true

# ==============================================================================
# MARKET DATA PROVIDER MODE
# ==============================================================================
# Controls how Argus resolves assets and fetches market data.
# ENV VAR: ARGUS_MARKET_DATA_PROVIDER_MODE
#
# live_provider: Real Alpaca/Kraken catalog calls (cached by Argus)
#   Use for: QA Mode and production-parity asset resolution
#
# recorded_provider_fixture: Cached JSON snapshots (repeatable, fast, predictable)
#   Use for: deterministic provider tests/CI only when ARGUS_ASSET_FIXTURE_PATH
#            points at a provider-shaped asset catalog snapshot

# synthetic_unit_fixture: Hardcoded test assets (AAPL, TSLA, BTC, ETH, etc.)
#   Use for: Dev Mode - fast iteration, no API calls, no Alpaca keys needed
#
# Default below is safe for direct local starts. .github/dev.sh and .github/qa.sh
# override it for their respective modes.
ARGUS_MARKET_DATA_PROVIDER_MODE=synthetic_unit_fixture

# Optional, only when ARGUS_MARKET_DATA_PROVIDER_MODE=recorded_provider_fixture.
# Not used by .github/qa.sh unless you intentionally edit that script.
ARGUS_ASSET_FIXTURE_PATH=

# =============================================================================
# OPTIONAL: Portfolio Configuration
# =============================================================================
# Uncomment and customize to override default symbols
# CRYPTO_SYMBOLS=BTC/USD,ETH/USD,XRP/USD
# EQUITY_SYMBOLS=NVDA,QQQ,GLD

# =============================================================================
# OPTIONAL: Rate Limiting
# =============================================================================
# Delay in seconds between API calls (Alpaca limit: 200 req/min)
RATE_LIMIT_DELAY=0.5

# =============================================================================
# REQUIRED: Environment Profile
# =============================================================================
# Single canonical environment selector for backend + frontend parity.
# Allowed values: development | production
APP_ENV=development
NEXT_PUBLIC_APP_ENV=${APP_ENV}

# Render Python services use Render's managed Poetry runtime. Keep this pinned
# instead of installing Poetry inside the build command.
POETRY_VERSION=2.1.3

# Local API URL (Frontend needs this to talk to the FastAPI backend)
# Default: http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_ARGUS_API_URL=http://127.0.0.1:8000/api/v1

# Public support address rendered on the privacy page, terms page, and profile
# menu (and used as the mail fallback when in-app support submission fails).
# support@get-argus.com forwards via Cloudflare Email Routing.
NEXT_PUBLIC_ARGUS_SUPPORT_EMAIL=support@get-argus.com

# Comma-separated browser origins allowed to call the backend from non-local
# deployments. Localhost dev origins are always included by the API.
# Render private-alpha launch:
# ARGUS_CORS_ALLOW_ORIGINS=https://argus-app-suz5.onrender.com
ARGUS_CORS_ALLOW_ORIGINS=

# ==============================================================================
# Runtime & Turn-Wide Execution Budgets
# ==============================================================================
# The SSE stream may remain open for this many seconds. The turn-wide deadline
# inherits this value when ARGUS_TURN_DEADLINE_SECONDS is blank.
ARGUS_RUNTIME_EVENT_TIMEOUT_SECONDS=180
ARGUS_RUNTIME_EVENT_KEEPALIVE_SECONDS=15
ARGUS_TURN_DEADLINE_SECONDS=

# Maximum provider attempts available to one accepted turn. The runtime caps
# this at the evidence-calibrated maximum of 7; smaller positive values tighten it.
ARGUS_TURN_CALL_ALLOWANCE=7

# ==============================================================================
# Supabase Configuration & Persistence Model
# ==============================================================================
# PERSISTENCE MODE:
#   memory: Ephemeral (good for Dev Mode - no Supabase needed, everything lost on restart)
#   supabase: Durable (required for QA Mode - full message/run/strategy persistence)
# .github/dev.sh and .github/qa.sh override this for normal local use.
ARGUS_PERSISTENCE_MODE=memory

# CHECKPOINT MODE (LangGraph runtime state):
#   memory: No persistence across server restarts (good for Dev Mode)
#   postgres: Persists to Supabase PostgreSQL (required for reload testing in QA Mode)
# If omitted, uses postgres when a script-provided Postgres connection is present;
# otherwise memory.
# .github/dev.sh and .github/qa.sh override this for normal local use.
ARGUS_CHECKPOINTER_MODE=memory

# DEV FALLBACK:
#   true: If Supabase writes fail, silently fall back to memory (tolerant, good for Dev Mode)
#   false: If Supabase writes fail, propagate error (strict, required for QA Mode)
# .github/dev.sh and .github/qa.sh override this for normal local use.
ARGUS_DEV_MEMORY_FALLBACK=false

# ==============================================================================
# PRIVATE-ALPHA FEATURE FLAGS
# ==============================================================================
# Spanish is part of the private-alpha language surface. Each feature flag
# below records its intended product default; incomplete surfaces remain off.

# Spanish (Latin America) private-alpha language option
# DEV MODE: true
# QA MODE: true
NEXT_PUBLIC_ENABLE_SPANISH=true

# Guest Experience is part of the normal product shape. These two Guest flags
# default on; explicit false is the emergency rollback kill switch. The public
# account flag remains a separate false-by-default account-creation gate.
ARGUS_GUEST_ACCESS_ENABLED=true
ARGUS_PUBLIC_ACCOUNT_ACCESS_ENABLED=false
NEXT_PUBLIC_GUEST_ACCESS_ENABLED=true
# Required for privacy-safe Guest discovery metering. Generate a unique,
# high-entropy value per deployed environment; do not reuse this example.
ARGUS_VISITOR_KEY_SECRET=replace_with_a_unique_random_secret
# Required before Guest entry is exposed from a non-loopback production host.
NEXT_PUBLIC_ARGUS_TURNSTILE_SITE_KEY=

# Backtest jobs shadow mode (API creates durable queued job rows while keeping
# the current in-process backtest result as the user-facing response)
# DEV MODE: false
# QA MODE: false unless explicitly validating Slice 2
ARGUS_BACKTEST_JOBS_SHADOW_ENABLED=false

# Backtest jobs workflow dispatch (starts a Render Workflow task after creating
# the durable job; still returns the current in-process result).
# Operational modes are synced with .github/render-env-sync.sh:
# - api-safe-off: all API workflow flags false; default for tester sessions.
# - api-proof-shadow-on: proof-only workflow_proof dispatch; infra validation.
# - api-real-workflow-on: real run_backtest_job dispatch; use only after the
#   frontend can render durable async job state.
# DEV MODE: false
# QA MODE: false unless explicitly validating workflow dispatch
ARGUS_BACKTEST_JOBS_DISPATCH_ENABLED=false
ARGUS_BACKTEST_WORKFLOW_TASK=argus-backtests/workflow_proof
ARGUS_BACKTEST_WORKFLOW_EXECUTION_ENABLED=false
ARGUS_BACKTEST_REAL_WORKFLOW_TASK=argus-backtests/run_backtest_job
ARGUS_BACKTEST_JOBS_USER_RUNNING_LIMIT=1
ARGUS_BACKTEST_JOBS_USER_QUEUED_LIMIT=2
ARGUS_BACKTEST_JOBS_GLOBAL_RUNNING_LIMIT=5
ARGUS_BACKTEST_JOBS_GLOBAL_QUEUED_LIMIT=10
RENDER_API_KEY=your_render_api_key_here

# OmniSearch (Unified search across conversations and results)
# DEV MODE: false (feature incomplete)
# QA MODE: false (feature incomplete)
NEXT_PUBLIC_OMNISEARCH_ENABLED=true

# Research rail presentation (entry copy, range-spanning chips, signed-in
# empty-chat greeting, confirmation peer offers). Ships dark; the founder
# flips it at promotion together with ARGUS_RESEARCH_RAIL_ENABLED.
NEXT_PUBLIC_RESEARCH_RAIL_ENABLED=true

# Public evidence receipts (share a completed result as an immutable public page).
# DEFAULT OFF, on purpose. This surface does not enable itself by landing:
# turning it on is a separate founder decision, and the gate is guest entry on a
# phone, because Try Argus lands there. Both variables must be true; either one
# false keeps every receipt path answering as if it did not exist.
# Backend serves creation, the owner's list, revocation, and the public read.
ARGUS_EVIDENCE_RECEIPT_SHARING_ENABLED=false
# Frontend renders /r/<id>, the share action, and the Data Controls list.
NEXT_PUBLIC_EVIDENCE_RECEIPT_SHARING_ENABLED=false

# In-place confirmation-card editing (direct-edit and peer-assets endpoints,
# advertised direct_edits, and the run-consumption stamp). Default off until
# the run-consumption guard lane (#437) closes; the founder flips it at
# promotion. Backend key only: the frontend derives from the card's
# direct_edits advertisement, so no NEXT_PUBLIC_ twin exists.
ARGUS_IN_PLACE_CARD_EDITS_ENABLED=false

# Context packets (Market context injected into explanations)
# DEV MODE: false (optional background task)
# QA MODE: true (recommended for full feature testing)
ARGUS_CONTEXT_PACKETS_ENABLED=true
ARGUS_CONTEXT_PACKET_BUDGET_SECONDS=4

# Supabase Credentials (QA Mode only; can be empty for Dev Mode)
# Find in Supabase Dashboard: Project Settings -> API
# Project URL:
SUPABASE_PROJECT_URL=YOUR_SUPABASE_PROJECT_URL
# Anon public key (frontend - used for public interactions):
SUPABASE_ANON_PUBLIC_KEY=YOUR_SUPABASE_ANON_KEY

# Runtime variables (do not edit directly; derived from canonical values above)
# Backend (FastAPI)
SUPABASE_URL=${SUPABASE_PROJECT_URL}
SUPABASE_ANON_KEY=${SUPABASE_ANON_PUBLIC_KEY}

# Supabase Service Keys (QA Mode only - required for persistent writes and recovery):
# - Service Role Key: backend uses this to bypass RLS and write to DB
# - JWT Secret: backend uses this to verify JWT tokens
# Get these from Supabase Dashboard: Settings -> API -> Service Role Key / JWT Secret
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Supabase Postgres connection strings (QA Mode only; can be empty for Dev Mode)
# Get from Supabase Dashboard: Connect -> Connection string.
# Keep these typed and unambiguous. .github/qa.sh uses the Session Pooler for
# the runtime checkpointer because it is the persistent-backend option that also
# works on IPv4-only networks. Direct is useful for migrations/psql on networks
# with IPv6 or the Supabase IPv4 add-on. Transaction Pooler is for short-lived
# serverless/edge-style clients, not the local QA runtime.
SUPABASE_POSTGRES_DIRECT_URL=YOUR_SUPABASE_POSTGRES_DIRECT_URL
SUPABASE_POSTGRES_SESSION_POOLER_URL=YOUR_SUPABASE_POSTGRES_SESSION_POOLER_URL
SUPABASE_POSTGRES_TRANSACTION_POOLER_URL=YOUR_SUPABASE_POSTGRES_TRANSACTION_POOLER_URL

# Render Workflow proof validation (not used by the normal chat/runtime path).
# DATABASE_URL is intentionally not declared in this file because .github/qa.sh
# derives it from SUPABASE_POSTGRES_SESSION_POOLER_URL for API QA. Render
# Workflow tasks are short-lived compute, so configure ARGUS_WORKFLOW_DATABASE_URL
# as a Render secret using SUPABASE_POSTGRES_TRANSACTION_POOLER_URL for the
# sandbox/project you are validating against.
ARGUS_WORKFLOW_DATABASE_URL=${SUPABASE_POSTGRES_TRANSACTION_POOLER_URL}
ARGUS_RENDER_WORKFLOW_PROOF_TASK=argus-backtests/workflow_proof
# Not read by app code: part of the hosted workflow-proof env contract that the
# release-config audit checks (canonical pin: .github/private-alpha-release-profile.json).
ARGUS_WORKFLOW_PROOF_PLAN=starter
ARGUS_BACKTEST_WORKFLOW_TIMEOUT_SECONDS=300

# Read-only stale backtest job scan used by .github/warmup-render.sh when present.
ARGUS_STALE_JOBS_SUPABASE_URL=${SUPABASE_PROJECT_URL}
ARGUS_STALE_JOBS_SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# Privacy-safe alpha ops metrics extractor over existing backtest job metadata.
ARGUS_ALPHA_METRICS_SUPABASE_URL=${SUPABASE_PROJECT_URL}
ARGUS_ALPHA_METRICS_SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# Scheduled maintenance (hosted Render cron service argus-maintenance, every 15
# minutes UTC) runs scripts/ops/scheduled_maintenance.py: guest retention plus
# stale/stranded job reconciliation. It introduces no new variable names. Its
# hosted env contract is ARGUS_RENDER_CRON_ENV in .github/argus-env.sh and the
# cron surface of .github/private-alpha-release-profile.json, and it reads only:
#   APP_ENV, POETRY_VERSION, ARGUS_PERSISTENCE_MODE, ARGUS_DEV_MEMORY_FALLBACK,
#   POSTHOG_REGION, POSTHOG_PROJECT_TOKEN, DATABASE_URL, SUPABASE_URL,
#   SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, RENDER_API_KEY
# DATABASE_URL is not declared in this file; locally .github/qa.sh exports it
# from SUPABASE_POSTGRES_SESSION_POOLER_URL, and in Render it is a manual secret.
# Run this entry point by hand only against an environment you intend to delete
# rows in.

# Frontend (Next.js, browser-exposed names)
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_PROJECT_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_PUBLIC_KEY}

# ==============================================================================
# DEVELOPER UTILITIES
# ==============================================================================
# MOCK AUTH:
#   true: Instantly logs in as "Mock Developer" for fast Dev Mode
#   false: Real Supabase auth, required for production-parity QA Mode
# Recommendation: use true only for local dev; keep false for QA auth validation
NEXT_PUBLIC_MOCK_AUTH=false
ARGUS_MOCK_AUTH=false
# Explicitly expose backend dev endpoints such as /api/v1/dev/reset.
# Keep false outside local/dev-only workflows.
ARGUS_DEV_ENDPOINTS_ENABLED=false
MOCK_USER_EMAIL=mock_user_email
MOCK_USER_PASSWORD=mock_user_password

# ==============================================================================
# MCP SERVER CONFIGURATION (PROJECT-LEVEL)
# ==============================================================================
# Shared by Codex (.codex/config.toml) and Claude Code (.mcp.json). The committed
# .mcp.json holds NO secrets: it references the vars below via ${VAR} expansion,
# so real values live here in .env (gitignored). Never paste raw keys into
# .mcp.json. These vars must be present in the shell that launches the agent
# (e.g. `set -a && source .env && set +a`).

# Supabase project ref = the <ref> subdomain of SUPABASE_PROJECT_URL
# (https://<ref>.supabase.co). Scopes the Supabase MCP to a single project.
# Point this at a DEV/branch project; Supabase MCP is dev/test-only, not prod.
SUPABASE_PROJECT_REF=your_supabase_project_ref_here

# Supabase MCP auth. Account-level Personal Access Token (NOT anon/service keys).
# Used by .mcp.json as a Bearer header; also the OAuth fallback for Codex.
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token_here

# Reuse the RENDER_API_KEY declared in the backtest workflow dispatch section
# above for Render MCP auth. Render keys are broadly scoped across all workspaces
# and services, so treat this server as founder-operated.

# Supabase MCP also supports interactive sign-in (/mcp in the Claude Code TUI).
# Stitch MCP uses local initialization:
#   npx @_davideast/stitch-mcp init

# ==============================================================================
# AI PROVIDER KEYS
# ==============================================================================
# Three-key policy (caps set on openrouter.ai per key):
#   argus-dev   -> $50/month -> local development and live evals only
#   argus-prod  -> $10/week  -> hosted registered traffic
#   argus-guest -> $5/week   -> hosted guest traffic
# TODAY (pre-routing): code reads only OPENROUTER_API_KEY everywhere — hosted
# carries argus-prod in it, local carries argus-dev. Once the key-routing lane
# lands, hosted stops reading OPENROUTER_API_KEY and the split below applies.
# Local development/eval key (argus-dev). Hosted runtimes will not read this
# after routing lands.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Hosted registered traffic (argus-prod, $10/week). Required in production,
# staging, and preview once key routing lands.
ARGUS_PROD_OPENROUTER_API_KEY=your_capped_registered_openrouter_api_key_here
# Hosted guest traffic (argus-guest, $5/week). Required in production,
# staging, and preview once key routing lands.
ARGUS_GUEST_ACCESS_OPENROUTER_API_KEY=your_capped_guest_openrouter_api_key_here
# Direct SMTP credential for the single waitlist-approval notification.
# Keep this server-only; Render supplies it manually with sync: false.
ARGUS_APPROVAL_EMAIL_SMTP_PASSWORD=your_resend_smtp_password_here
# Public web origin used to build approval signup links.
ARGUS_APP_ORIGIN=http://localhost:3000
# Optional future provider key if Argus adds direct Groq routing.
# GROQ_API_KEY=your_groq_api_key_here

# Optional contextual intelligence providers. These should enrich explanations,
# not become sources of simulation truth.
TAVILY_API_KEY=your_tavily_api_key_here
FRED_API_KEY=your_fred_api_key_here
# Curated macro context series. CPIAUCSL, CPILFESL, UNRATE, PAYEMS, and INDPRO
# are seasonally adjusted; market-rate and recession indicator series are not
# treated as simulation truth.
ARGUS_FRED_CONTEXT_SERIES=FEDFUNDS,DGS10,DGS2,T10Y2Y,CPIAUCSL,CPILFESL,UNRATE,PAYEMS,INDPRO,USREC
# Best-effort context packet collection for completed runs. Packets are replay
# snapshots for explanations and follow-ups, not simulation truth.
ARGUS_CONTEXT_PACKETS_ENABLED=true
ARGUS_CONTEXT_PACKET_BUDGET_SECONDS=4
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Research rail (spec 2026-08-07-research-to-test-rail.md, issue #377).
# finance_search-grounded question answering behind a default-off flag;
# flag-off behavior is byte-identical to the pre-rail router.
ARGUS_RESEARCH_RAIL_ENABLED=true
# Shared daily circuit breaker for provider attempts across all users.
# Sized for the default question path, not opt-in discovery volume.
ARGUS_RESEARCH_GLOBAL_DAILY_CEILING=5000
# Thorough runs poll Perplexity background mode up to this deadline.
ARGUS_RESEARCH_BACKGROUND_DEADLINE_SECONDS=600

# Grounded Discovery Search (issue #244). This is part of the normal Argus
# shape and defaults on. Set false only as an emergency Search kill switch;
# flag-off returns honest "discovery unavailable" recovery with zero calls.
ARGUS_GROUNDED_DISCOVERY_ENABLED=true
# Provider adapter id: perplexity_direct | openrouter_web_search.
ARGUS_DISCOVERY_SEARCH_PROVIDER=perplexity_direct
# Optional; required only when ARGUS_DISCOVERY_SEARCH_PROVIDER=openrouter_web_search.
ARGUS_DISCOVERY_OPENROUTER_SEARCH_MODEL=
ARGUS_DISCOVERY_SEARCH_TIMEOUT_SECONDS=8
# Visible-candidate ceiling; clamped to 1..5 (matches the run symbol cap).
ARGUS_DISCOVERY_MAX_CANDIDATES=5
# Per-user Search-attempt allowances (usage_counters resource discovery_searches).
ARGUS_DISCOVERY_HOURLY_LIMIT=10
ARGUS_DISCOVERY_DAILY_LIMIT=25
# Global attempted-search circuit breaker shared by guests and registered users.
# Invalid, blank, or non-positive values fall back to the code-owned default 500.
ARGUS_DISCOVERY_GLOBAL_DAILY_CEILING=500

# ==============================================================================
# RUNTIME FEATURE FLAGS
# ==============================================================================
# Title Auto-Generation (Both Scenarios):
#   true: AI generates conversation titles after first turn (recommended for QA Mode)
#   false: Manual titles only
ARGUS_TITLE_AUTOGEN_ENABLED=true
ARGUS_TITLE_AUTOGEN_TIMEOUT_MS=250  # ms; fire-and-forget after stream completion
# ==============================================================================
# LLM MODEL ROUTING TIERS
# ==============================================================================
# Format: <provider>/<model_name>
# Keep each fallback in the same capability class as its primary model.

# Tier 0: deterministic runtime, validation, persistence, and simulation truth.
# No model variable belongs to this tier.

# Tier 1: Utility (titles, strategy names, rewrites) - FAST/CHEAP
ARGUS_UTILITY_MODEL=your_utility_model_here
ARGUS_UTILITY_FALLBACK_MODEL=your_utility_fallback_model_here

# Tier 2: Chat (conversation, clarification, education, summaries) - BALANCED
ARGUS_CHAT_MODEL=your_chat_model_here
ARGUS_CHAT_FALLBACK_MODEL=your_chat_fallback_model_here
ARGUS_OPENROUTER_RESULT_SUMMARY_TIMEOUT_SECONDS=30

# Tier 3: Structured (artifact planning, JSON/schema, draft edits) - RELIABLE
ARGUS_STRUCTURED_MODEL=your_structured_model_here
ARGUS_STRUCTURED_FALLBACK_MODEL=your_structured_fallback_model_here

# Tier 4: Context (market context, "why did this happen?") - PREMIUM
ARGUS_CONTEXT_MODEL=your_context_model_here
ARGUS_CONTEXT_FALLBACK_MODEL=your_context_fallback_model_here

# Execution realism (fees + slippage modeling). Enabled by default; set to
# "false" as a kill switch to restore idealized-only behavior byte-for-byte.
# Costs are user opt-in per idea either way.
ARGUS_ENABLE_EXECUTION_REALISM=true

# Personalization memory. Off by default; with it off the surface is inert
# and chat behavior is byte-identical. Turning it on exposes memory only to
# private_alpha_allowlist accounts with the admin or developer role, and the
# process must restart for a change to take effect.
ARGUS_ENABLE_PERSONALIZATION_MEMORY=false

# Semantic memory recall. Off by default; with it off, recall is the canonical
# token match and no memory text ever leaves the process. Turning it on indexes
# already-confirmed memories into pgvector in the existing Supabase database
# and vectorizes them through the existing PERPLEXITY_API_KEY: transit only,
# nothing is stored with the vendor. Requires supabase persistence mode and
# that key; without either, recall silently stays on the token match.
ARGUS_ENABLE_MEMORY_SEMANTIC_RECALL=false

# Perplexity embedding model and vector width for semantic recall. The width
# must match the model, and changing either after records are indexed requires
# rebuilding the collection.
ARGUS_MEMORY_EMBEDDING_MODEL=pplx-embed-v1-0.6b
ARGUS_MEMORY_EMBEDDING_DIMENSIONS=1024
ARGUS_MEMORY_EMBEDDING_TIMEOUT_SECONDS=8.0

# pgvector collection holding the derivative memory index. The index is
# disposable: dropping it costs recall quality, never a memory.
ARGUS_MEMORY_VECTOR_COLLECTION=argus_memory_vectors

# ==============================================================================
# BACKEND PARITY — variables the code reads that were missing from this template
# (promotion pre-flight audit, 2026-08-04)
# ==============================================================================
# DATABASE_URL is intentionally NOT set here: the runtime and QA scripts derive
# it from the typed SUPABASE_POSTGRES_* URLs above (qa.sh exports it from the
# session pooler). Signup username serialization and QA stacks read the derived
# value. Configure the typed URLs; never set a bare DATABASE_URL in this file.
# Bearer token protecting internal ops endpoints. Server-only.
ARGUS_OPS_TOKEN=your_ops_token_here
# Streaming worker pool tuning. Code defaults apply when unset.
ARGUS_RUNTIME_STREAM_WORKER=
ARGUS_RUNTIME_STREAM_WORKERS=
# Market-data disk cache. Code default is ENABLED (true) with a 900s TTL;
# set false only to force fresh provider fetches while debugging.
ENABLE_MARKET_DATA_CACHE=true
MARKET_DATA_CACHE_TTL=
# Readiness probe timeout for asset-provider warmup.
ARGUS_READINESS_ASSET_TIMEOUT_SECONDS=
# Legacy alias read alongside ARGUS_MARKET_DATA_PROVIDER_MODE; leave unset.
ARGUS_ASSET_PROVIDER_MODE=
# Asset-universe loader timeout override.
ARGUS_ASSET_UNIVERSE_LOADER_TIMEOUT_SECONDS=

# --- Product analytics (PostHog), server-side capture only ---
# Capture runs ONLY when BOTH token and region are set; otherwise events are
# silently suppressed. Blank locally = off (keeps dev noise out of analytics).
# Events carry environment from APP_ENV, so environments stay filterable.
# US Cloud is the launch compliance posture (see PRIVATE_LAUNCH_RUNBOOK).
# Note: POSTHOG_API_KEY / POSTHOG_PROJECT_ID are PostHog management-API
# credentials for external tooling; Argus code never reads them.
POSTHOG_PROJECT_TOKEN=
POSTHOG_REGION=
# Optional: explicit ingestion host override (self-hosted); beats POSTHOG_REGION.
POSTHOG_HOST=
# Optional capture timeout, default 0.75s.
ARGUS_POSTHOG_TIMEOUT_SECONDS=

# --- Dev/test-only. Never set on hosted services. ---
RENDER_USE_LOCAL_DEV=false
RENDER_LOCAL_DEV_URL=
ARGUS_ENABLE_ARTIFACT_NAMING_IN_TESTS=false

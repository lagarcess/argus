{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/recovery/layout,_N_T_/auth/recovery/page,_N_T_/auth/recovery"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/auth/recovery/__PAGE__",
    "/auth/recovery",
    "/auth",
    "/_index",
    "/_head"
  ]
}
exports[`receipt body in en preserves the complete v1 main markup 1`] = `"<main class="mx-auto flex w-full max-w-[620px] flex-col px-5 pt-5 sm:px-8 sm:pt-9 pb-[calc(112px_+_env(safe-area-inset-bottom))]"><div class="flex items-center justify-between gap-3"><span class="font-display inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-[12px] font-medium tracking-[0.02em] text-white/70"><span aria-hidden="true" class="inline-block h-[6px] w-[6px] rounded-full bg-[#5ba897]"></span>Tested with Argus</span><span class="text-[10.5px] uppercase tracking-[0.1em] text-white/40">September 9, 2026</span></div><h1 lang="en" class="font-display mt-4 text-[23px] font-medium leading-[1.16] tracking-[-0.5px] text-white sm:text-[30px] sm:tracking-[-0.8px]">Monthly AAPL investing</h1><div class="mt-4 pt-5 border-t border-white/10"><div class="font-display text-[52px] font-medium leading-[0.98] tracking-[-1.9px] tabular-nums sm:text-[62px] sm:tracking-[-2.4px] text-[#5ba897]">+18.4%</div><p class="font-display mt-2.5 text-[15px] font-medium tabular-nums text-white">9.3 pts ahead of SPY<span class="font-medium text-white/45"> · SPY +9.1%</span></p><dl class="mt-4"><div class="flex items-baseline justify-between gap-3 py-2 border-t border-white/10"><dt class="text-[11.5px] text-white/45">What</dt><dd class="font-display text-[13.5px] tabular-nums text-white/90">AAPL · Stocks</dd></div><div class="flex items-baseline justify-between gap-3 py-2 border-t border-white/10"><dt class="text-[11.5px] text-white/45">When</dt><dd class="font-display text-[13.5px] tabular-nums text-white/90">Jan 2, 2024 to Dec 31, 2024</dd></div><div class="flex items-baseline justify-between gap-3 py-2 border-t border-white/10"><dt class="text-[11.5px] text-white/45">Worst dip</dt><dd class="font-display text-[13.5px] tabular-nums text-white/90">-6.2%</dd></div></dl></div><section class="mt-4 pt-5 border-t border-white/10"><h2 class="text-[10px] font-medium uppercase tracking-[0.1em] text-[#5ba897]">What ran</h2><div class="mt-2.5 flex flex-col"><div class="pb-2.5"><p class="text-[14px] leading-[1.45] text-white">Bought every month, whatever the price was that day. It never sold.</p></div></div><ul class="mt-3.5 flex flex-col gap-1 text-[11.5px] leading-[1.5] text-white/40"><li>Long only</li><li>Equal weight</li><li>$250 every month</li><li>$0 to start</li><li>No fees or slippage</li></ul><p class="mt-2 text-[11.5px] leading-[1.5] text-white/40">These numbers are locked and will not change.</p></section><blockquote class="mt-6 border-l-2 border-white/15 pl-4 text-[14px] leading-relaxed text-white/70">A small monthly experiment.</blockquote><div class="mt-5 pt-4 border-t border-white/10"><p class="text-[12.5px] leading-relaxed text-[#c2a44d]">Someone wondered how this idea would have gone, so Argus checked it against what the market actually did on those dates. No real money moved, nobody bought anything, and this says nothing about what happens next.</p></div></main>"`;

exports[`receipt body in es-419 preserves the complete v1 main markup 1`] = `"<main class="mx-auto flex w-full max-w-[620px] flex-col px-5 pt-5 sm:px-8 sm:pt-9 pb-[calc(112px_+_env(safe-area-inset-bottom))]"><div class="flex items-center justify-between gap-3"><span class="font-display inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-[12px] font-medium tracking-[0.02em] text-white/70"><span aria-hidden="true" class="inline-block h-[6px] w-[6px] rounded-full bg-[#5ba897]"></span>Probado con Argus</span><span class="text-[10.5px] uppercase tracking-[0.1em] text-white/40">9 de septiembre de 2026</span></div><h1 lang="en" class="font-display mt-4 text-[23px] font-medium leading-[1.16] tracking-[-0.5px] text-white sm:text-[30px] sm:tracking-[-0.8px]">Monthly AAPL investing</h1><div class="mt-4 pt-5 border-t border-white/10"><div class="font-display text-[52px] font-medium leading-[0.98] tracking-[-1.9px] tabular-nums sm:text-[62px] sm:tracking-[-2.4px] text-[#5ba897]">+18.4%</div><p class="font-display mt-2.5 text-[15px] font-medium tabular-nums text-white">9.3 pts por encima de SPY<span class="font-medium text-white/45"> · SPY +9.1%</span></p><dl class="mt-4"><div class="flex items-baseline justify-between gap-3 py-2 border-t border-white/10"><dt class="text-[11.5px] text-white/45">Qué</dt><dd class="font-display text-[13.5px] tabular-nums text-white/90">AAPL · Acciones</dd></div><div class="flex items-baseline justify-between gap-3 py-2 border-t border-white/10"><dt class="text-[11.5px] text-white/45">Cuándo</dt><dd class="font-display text-[13.5px] tabular-nums text-white/90">2 ene 2024 al 31 dic 2024</dd></div><div class="flex items-baseline justify-between gap-3 py-2 border-t border-white/10"><dt class="text-[11.5px] text-white/45">Peor caída</dt><dd class="font-display text-[13.5px] tabular-nums text-white/90">-6.2%</dd></div></dl></div><section class="mt-4 pt-5 border-t border-white/10"><h2 class="text-[10px] font-medium uppercase tracking-[0.1em] text-[#5ba897]">Qué se ejecutó</h2><div class="mt-2.5 flex flex-col"><div class="pb-2.5"><p class="text-[14px] leading-[1.45] text-white">Compró cada mes, sin importar el precio de ese día. Nunca vendió.</p></div></div><ul class="mt-3.5 flex flex-col gap-1 text-[11.5px] leading-[1.5] text-white/40"><li>Solo largo</li><li>Peso igual</li><li>$250 cada mes</li><li>$0 al inicio</li><li>Sin comisiones ni deslizamiento</li></ul><p class="mt-2 text-[11.5px] leading-[1.5] text-white/40">Estos números quedaron fijos y no van a cambiar.</p></section><blockquote class="mt-6 border-l-2 border-white/15 pl-4 text-[14px] leading-relaxed text-white/70">A small monthly experiment.</blockquote><div class="mt-5 pt-4 border-t border-white/10"><p class="text-[12.5px] leading-relaxed text-[#c2a44d]">Alguien tuvo curiosidad por saber cómo le habría ido a esta idea, así que Argus la revisó con lo que el mercado hizo de verdad en esas fechas. No se movió dinero real, nadie compró nada, y esto no dice nada sobre lo que va a pasar.</p></div></main>"`;
